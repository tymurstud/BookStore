@model BookStore.Web.Models.ErrorViewModel

@{
    ViewData["Title"] = "Blad";
}

<h1 class="text-danger">Blad serwera (500)</h1>

@if (Model.ShowRequestId)
{
    <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
}

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-warning"><strong>Szczegoly:</strong> @Model.Message</div>
}

<a asp-controller="Home" asp-action="Index" class="btn btn-primary">Strona glowna</a>
