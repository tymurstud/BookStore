@{
    ViewData["Title"] = "Dashboard";
}

<h2>Dashboard</h2>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card text-bg-primary">
            <div class="card-body">
                <h5 class="card-title">Wszystkie zadania</h5>
                <p class="card-text display-6">@ViewBag.Total</p>
            </div>
        </div>
    </div>
</div>

<h4>Top 5 sciezek</h4>
<table class="table table-sm table-striped">
    <thead><tr><th>Sciezka</th><th>Liczba zadan</th></tr></thead>
    <tbody>
        @foreach (var (path, count) in (IEnumerable<(string, long)>)ViewBag.Top5)
        {
            <tr><td><code>@path</code></td><td>@count</td></tr>
        }
    </tbody>
</table>
